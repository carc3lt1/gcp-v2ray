# ==========================================================
# Caddyfile - Arquitectura Proxy Dual
# Evasión DPI, Camuflaje de Tráfico y Enrutamiento VLESS
# ==========================================================

:8080 {
    # ------------------------------------------------------
    # 1. TÚNEL PRINCIPAL (Xray-core)
    # Enruta directamente a Xray ocultando la IP del cliente.
    # ------------------------------------------------------
    handle /CARC3LT {
        reverse_proxy 127.0.0.1:10000 {
            # Enmascaramiento: Borra tu IP real y la sustituye por localhost
            header_up X-Forwarded-For "127.0.0.1"
            header_up X-Real-IP "127.0.0.1"
        }
    }

    # ------------------------------------------------------
    # 2. DEFENSA ACTIVA Y CAMUFLAJE (Honeypot API)
    # Respuesta falsa que devuelve una IP de loopback local
    # para confundir a los auditores de red.
    # ------------------------------------------------------
    handle {
        header Content-Type application/json
        header Access-Control-Allow-Origin *
        
        respond `{
  "system_status": "operational",
  "service": "gcp-api-gateway",
  "environment": "production",
  "version": "v2.1.4",
  "active_nodes": 4,
  "telemetry_routing": "enabled",
  "auth_required": true,
  "region": "us-central1",
  "client_ip_resolved": "127.0.0.1",
  "network_isolation": "active",
  "timestamp": "auto-sync"
}` 200
    }
}
