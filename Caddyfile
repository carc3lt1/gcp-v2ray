# ==========================================================
# Caddyfile - Arquitectura Proxy gRPC Estable
# Evasión DPI y Camuflaje JSON (Google Cloud Run)
# ==========================================================

:8080 {
    # ------------------------------------------------------
    # 1. TÚNEL PRINCIPAL (Xray-core gRPC)
    # Enruta el tráfico gRPC hacia el backend usando HTTP/2 (h2c).
    # Sin manipulación de cabeceras para evitar bloqueos 429.
    # ------------------------------------------------------
    handle /CARC3LT/* {
        reverse_proxy h2c://127.0.0.1:10000
    }

    # ------------------------------------------------------
    # 2. DEFENSA ACTIVA (Honeypot API)
    # Respuesta JSON pura para engañar escáneres DPI.
    # ------------------------------------------------------
    handle {
        header Content-Type application/json
        header Access-Control-Allow-Origin *
        
        respond `{
  "system_status": "operational",
  "service": "gcp-api-gateway",
  "environment": "production",
  "version": "v2.1.4",
  "active_nodes": 4,
  "telemetry_routing": "enabled",
  "auth_required": true,
  "region": "us-central1",
  "client_ip_resolved": "127.0.0.1",
  "network_isolation": "active",
  "timestamp": "auto-sync"
}` 200
    }
}
