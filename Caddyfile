# ==========================================================
# Caddyfile - Arquitectura Proxy WebSocket (Revertida)
# Evasión DPI y Camuflaje JSON (Google Cloud Run)
# ==========================================================

:8080 {
    # 1. TÚNEL PRINCIPAL (Xray-core WebSocket)
    # Enruta el tráfico WS limpio hacia el backend local.
    handle /CARC3LT {
        reverse_proxy 127.0.0.1:10000
    }

    # 2. DEFENSA ACTIVA (Honeypot API)
    # Respuesta JSON para despistar escáneres DPI
    handle {
        header Content-Type application/json
        header Access-Control-Allow-Origin *
        
        respond `{
  "system_status": "operational",
  "service": "gcp-api-gateway",
  "environment": "production",
  "version": "v2.1.4",
  "active_nodes": 4,
  "telemetry_routing": "enabled",
  "auth_required": true,
  "region": "us-central1",
  "client_ip_resolved": "127.0.0.1",
  "network_isolation": "active",
  "timestamp": "auto-sync"
}` 200
    }
}
